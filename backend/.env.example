APP_NAME=JobFlow API
APP_ENV=dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/jobflow
SECRET_KEY=change-me

# --- Job sources -----------------------------------------------------------
# Comma-separated, in priority order.
#   greenhouse  real SA listings from named employers, full descriptions, no key
#   adzuna      real SA listings, broad coverage, truncated descriptions
#   seed        synthetic sample data — OFFLINE DEVELOPMENT ONLY, never in production
JOB_SOURCES=greenhouse,adzuna

# Free app id + key from https://developer.adzuna.com/ (~1,000 calls/month).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Greenhouse public boards as `token:Display Name`, comma-separated.
GREENHOUSE_BOARDS=luno:Luno,ozow:Ozow,entersekt:Entersekt,stitch:Stitch

# --- AI (Groq) -------------------------------------------------------------
# Free key from https://console.groq.com/. Without it the /ai endpoints
# return 503 and the UI hides the AI features.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Notifications ---------------------------------------------------------
# Public URL of the frontend, used for links inside alert messages.
FRONTEND_URL=http://localhost:5173

# WhatsApp job alerts via Meta's Cloud API. Requires a WhatsApp Business
# account with a registered number, and an APPROVED message template — Meta
# only permits business-initiated messages from a template, and a job alert
# is always business-initiated. The template must take one body variable.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# With no channel configured, write alerts to the log instead of dropping
# them, so the matching and scheduling logic can be exercised locally.
NOTIFICATIONS_FALLBACK_TO_CONSOLE=true
